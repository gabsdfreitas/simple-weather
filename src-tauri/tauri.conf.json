{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Simple Weather",
  "version": "0.1.0",
  "identifier": "com.simpleWeather.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Simple Weather",
        "width": 1366,
        "height": 768,
        "minWidth": 480,
        "minHeight": 400,
        "resizable": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "category": "Weather",
    "shortDescription": "A lightweight weather app with dynamic sky backgrounds",
    "homepage": "https://github.com/placeholder",
    "license": "MIT",
    "targets": [
      "deb",
      "rpm"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/256x256.png",
      "icons/512x512.png",
      "icons/icon.ico",
      "icons/icon.svg"
    ],
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "libssl3"
        ],
        "section": "utils",
        "priority": "optional"
      },
      "rpm": {
        "depends": [
          "webkit2gtk4.1",
          "gtk3",
          "openssl"
        ]
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  }
}
